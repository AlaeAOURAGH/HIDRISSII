# Copy to .env.local for `vercel dev`, and set the same vars in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.

# WhatsApp business number — country code, no "+", no spaces.
# Served to the browser via /api/config (so it is NOT hard-coded in the page).
WA_NUMBER=212641451387

# --- Google Sheets lead capture (used by /api/order) ---
# 1. Google Cloud → create a Service Account, enable the "Google Sheets API".
# 2. Create a JSON key; copy the client_email and private_key below.
# 3. Share your Google Sheet with that client_email (Editor access).
# 4. Sheet tab named "Orders" with header row:
#    timestamp | name | phone | city | product | qty | price | address | note | lang
GOOGLE_SERVICE_ACCOUNT_EMAIL=orders@your-project.iam.gserviceaccount.com
# Keep the literal \n sequences (they are converted to real newlines at runtime).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# The long ID from the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=your_google_sheet_id
# Optional — defaults to Orders!A:J
GOOGLE_SHEET_RANGE=Orders!A:J
